# Software DNA backend — copy to .env and fill in.
# Never commit a real .env; it is git-ignored.

# ---- Database -------------------------------------------------------------
# Required in every environment except the `localdb` profile, which starts an
# embedded PostgreSQL for local development.
DATABASE_URL=jdbc:postgresql://localhost:5432/softwaredna
DATABASE_USERNAME=softwaredna
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=10

# ---- GitHub ---------------------------------------------------------------
# Optional. Without a token the public API allows 60 requests/hour, which is
# enough to try the service but not to run it. A fine-grained token needs only
# public repository read access.
# The token is never returned by an endpoint, logged, or written into a clone.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ---- Analysis limits ------------------------------------------------------
# A repository is untrusted input; these are the ceilings that stop a hostile
# or merely enormous one from exhausting the host.
WORKSPACE_ROOT=/tmp/software-dna-workspaces
WORKSPACE_KEEP=false
ANALYSIS_WORKERS=2
ANALYSIS_QUEUE=50

# ---- AI Doctor ------------------------------------------------------------
# `deterministic` answers from the analysis itself and needs no credentials.
# It is a real provider, not a stub: every figure it quotes is read from the
# stored profile.
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=

# ---- Server ---------------------------------------------------------------
SERVER_PORT=8080
LOG_LEVEL=INFO
